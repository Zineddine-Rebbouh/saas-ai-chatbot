# ─── Database (Neon) ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct connection — used only by prisma db push / migrate
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ─── Clerk Authentication ────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/auth/callback"

# ─── Stripe Payments ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISH_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_SUBSCRIPTION_PRICE_ID_MONTHLY_PRO="price_..."
STRIPE_SUBSCRIPTION_PRICE_ID_MONTHLY_ULTIMATE="price_..."

# ─── Pusher Real-Time ────────────────────────────────────────────────────────
NEXT_PUBLIC_PUSHER_APP_KEY="..."
NEXT_PUBLIC_PUSHER_APP_ID="..."
# Server-only: never NEXT_PUBLIC_ (it would ship to browsers)
PUSHER_APP_SECRET="..."
NEXT_PUBLIC_PUSHER_APP_CLUSTER="us2"

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ─── Email (Nodemailer / Gmail) ───────────────────────────────────────────────
NODE_MAILER_EMAIL="your@gmail.com"
NODE_MAILER_GMAIL_APP_PASSWORD="..."

# ─── Uploadcare (File Uploads) ───────────────────────────────────────────────
NEXT_PUBLIC_UPLOAD_CARE_PUBLIC_KEY="..."

# ─── Blog Image CDN ───────────────────────────────────────────────────────────
CLOUDWAYS_UPLOADS_URL="https://your-cdn-url.com/uploads/"
CLOUDWAYS_POSTS_URL="https://your-wordpress-site.com/wp-json/wp/v2/posts"
CLOUDWAYS_FEATURED_IMAGES_URL="https://your-wordpress-site.com/wp-json/wp/v2/media"
CLOUDWAYS_USERS_URL="https://your-wordpress-site.com/wp-json/wp/v2/users/"

# ─── App URL (used for Stripe redirects + links generated server-side) ───────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Set to "true" to enable demo mode (seeded demo account, no sign-up required)
NEXT_PUBLIC_DEMO_MODE="false"
